#!/usr/bin/env bash
# pre-push: block direct push to protected branches, run the project's tests
# (best-effort across stacks), and surface soft reminders. Non-test failures never block.
set -uo pipefail
protected="main master"
ZERO="0000000000000000000000000000000000000000"
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  branch=${remote_ref#refs/heads/}
  for p in $protected; do
    if [ "$branch" = "$p" ]; then
      echo "✗ pre-push：禁止直推 '$p'。请从 feature 分支开 PR。" >&2
      exit 1
    fi
  done
  # force-push / 改写历史检测：remote_sha 是真实 commit 且不是 local 的祖先 = 非快进(ask 三态)。
  # remote_sha 为 40 个 0(新分支)或无效 sha → 不是 force-push,跳过。
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null \
     && [ -n "$local_sha" ] && [ "$local_sha" != "$ZERO" ] \
     && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "⚠ pre-push：检测到对 '$branch' 的 force-push / 改写历史(非快进)。" >&2
    if [ "${HARNESS_CONFIRM:-}" = "1" ]; then
      echo "  HARNESS_CONFIRM=1 已确认,放行。" >&2
    elif [ -r /dev/tty ]; then
      printf "  确认要 force-push 吗? [y/N] " >&2
      read -r _ans < /dev/tty || _ans=""
      case "$_ans" in y|Y|yes) : ;; *) echo "✗ 已取消。" >&2; exit 1 ;; esac
    else
      echo "  非交互环境:放行但请留意。要静默确认设 HARNESS_CONFIRM=1。" >&2
    fi
  fi
done

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

# Best-effort test run across common stacks. Server-side CI (ci-gate) is the real gate.
run_tests() {
  if [ -f package.json ] && grep -q '"test"' package.json; then echo "npm test"; npm test --silent; return $?; fi
  if [ -f Makefile ] && grep -qE '^test:' Makefile; then echo "make test"; make test; return $?; fi
  if [ -f pyproject.toml ] || [ -f pytest.ini ] || [ -d tests ]; then
    if command -v pytest >/dev/null 2>&1; then echo "pytest"; pytest -q; return $?; fi
  fi
  if [ -f go.mod ]; then echo "go test"; go test ./...; return $?; fi
  if [ -f Cargo.toml ]; then echo "cargo test"; cargo test --quiet; return $?; fi
  return 0   # no recognizable test command -> don't block
}
if ! run_tests; then echo "✗ pre-push：测试未通过。" >&2; exit 1; fi

# Soft reminders (never block).
[ -x "$ROOT/scripts/stale-cases.sh" ]  && "$ROOT/scripts/stale-cases.sh"  || true
[ -x "$ROOT/scripts/memory-stats.sh" ] && "$ROOT/scripts/memory-stats.sh" || true
exit 0
