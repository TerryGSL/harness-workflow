#!/usr/bin/env bash
# pre-commit: refuse to commit secret/credential files. Pattern shared via gate-lib.sh.
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel)
SECRET_RE='(^|/)\.env($|\.)|(^|/)secrets?/'   # conservative fallback if lib missing
[ -r "$ROOT/scripts/gate-lib.sh" ] && . "$ROOT/scripts/gate-lib.sh"

staged=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
blocked=$(printf '%s\n' "$staged" | grep -E "$SECRET_RE" | grep -vE '\.(example|template|sample|dist)$' || true)
if [ -n "$blocked" ]; then
  echo "✗ pre-commit：拒绝提交密钥/凭证文件：" >&2
  printf '%s\n' "$blocked" | sed 's/^/    /' >&2
  echo "  把它们加进 .gitignore（确实必要才用 --no-verify）。" >&2
  exit 1
fi

# 入口文件行数治理（单一规则源；存在才查）
if [ -r "$ROOT/scripts/verify-governance.sh" ]; then
  bash "$ROOT/scripts/verify-governance.sh" >&2 || exit 1
fi
exit 0
