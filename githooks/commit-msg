#!/usr/bin/env bash
# commit-msg: memory 门 + 证据门(都委派到 scripts/, 与 CI 共享 gate-lib 规则)。
set -uo pipefail
ROOT=$(git rev-parse --show-toplevel)
[ -x "$ROOT/scripts/verify-memory.sh" ]   && { "$ROOT/scripts/verify-memory.sh" "$1"   || exit 1; }
[ -x "$ROOT/scripts/verify-evidence.sh" ] && { "$ROOT/scripts/verify-evidence.sh" "$1" || exit 1; }
exit 0
